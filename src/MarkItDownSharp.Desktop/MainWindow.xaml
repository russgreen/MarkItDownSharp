<Window
    x:Class="MarkItDownSharp.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:MarkItDownSharp.Presentation"
    xmlns:worker="using:MarkItDownSharp.Worker"
    Title="MarkItDownSharp">
    <Grid x:Name="RootGrid" Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="MarkItDownSharp"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Convert files added to a folder into Markdown." />
        </StackPanel>

        <SelectorBar Grid.Row="1" x:Name="Sections" SelectionChanged="Sections_SelectionChanged"
                     AutomationProperties.Name="Main sections" TabIndex="0">
            <SelectorBarItem Text="Conversions" IsSelected="True" AutomationProperties.Name="Conversions" />
            <SelectorBarItem Text="Settings" AutomationProperties.Name="Settings" />
            <SelectorBarItem Text="Converters" AutomationProperties.Name="Converters" />
            <SelectorBarItem Text="About" AutomationProperties.Name="About and diagnostics" />
        </SelectorBar>

        <Grid Grid.Row="2" x:Name="SectionHost">

            <!-- ===== Conversions ===== -->
            <Grid x:Name="ConversionsPanel" RowSpacing="12" Padding="0,8,0,0">
                <Grid RowSpacing="12" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <InfoBar Grid.Row="0" Severity="Informational" IsClosable="True"
                             IsOpen="{x:Bind ViewModel.ShowWelcome, Mode=TwoWay}"
                             Title="Welcome to MarkItDownSharp"
                             Message="Choose a folder to watch and a folder for the Markdown output, then press Start. New and changed files are converted automatically."
                             AutomationProperties.Name="Welcome guidance">
                        <InfoBar.Content>
                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                <TextBlock FontWeight="SemiBold" Text="Supported formats" />
                                <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Text="{x:Bind ViewModel.SupportedFormatsSummary, Mode=OneWay}"
                                           AutomationProperties.Name="Supported file formats" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Office, PDF, EPUB, ZIP and e-mail files are converted locally. Network converters are off unless you configure them in Settings." />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>

                    <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Monitor folder" />
                        <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                                 Text="{x:Bind ViewModel.SourceDirectory, Mode=OneWay}"
                                 AutomationProperties.Name="Monitor folder path" TabIndex="1" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseSource_Click"
                                AutomationProperties.Name="Browse for monitor folder" AccessKey="M" TabIndex="2" />

                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Output folder" />
                        <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                 Text="{x:Bind ViewModel.OutputDirectory, Mode=OneWay}"
                                 AutomationProperties.Name="Output folder path" TabIndex="3" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click"
                                AutomationProperties.Name="Browse for output folder" AccessKey="O" TabIndex="4" />

                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="18">
                            <CheckBox Content="Include subfolders" TabIndex="5"
                                      IsChecked="{x:Bind ViewModel.IncludeSubdirectories, Mode=TwoWay}"
                                      AutomationProperties.Name="Include subfolders" />
                            <CheckBox Content="Process existing files" TabIndex="6"
                                      IsChecked="{x:Bind ViewModel.ProcessExistingFiles, Mode=TwoWay}"
                                      AutomationProperties.Name="Process existing files" />
                            <ComboBox Header="Existing output" TabIndex="7"
                                      SelectedIndex="{x:Bind ViewModel.CollisionIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="What to do when the output file exists">
                                <ComboBoxItem Content="Overwrite" />
                                <ComboBoxItem Content="Skip" />
                                <ComboBoxItem Content="Create version" />
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="Start" Command="{x:Bind ViewModel.StartCommand}" Style="{StaticResource AccentButtonStyle}"
                                        AutomationProperties.Name="Start monitoring" AccessKey="S" TabIndex="8"
                                        ToolTipService.ToolTip="Start monitoring (F5)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F5" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button Content="{x:Bind ViewModel.PauseResumeLabel, Mode=OneWay}" Command="{x:Bind ViewModel.PauseResumeCommand}"
                                        AutomationProperties.Name="Pause or resume monitoring" TabIndex="9"
                                        ToolTipService.ToolTip="Pause or resume monitoring (Ctrl+P)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="P" Modifiers="Control" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button Content="Stop" Command="{x:Bind ViewModel.StopCommand}"
                                        AutomationProperties.Name="Stop monitoring" TabIndex="10"
                                        ToolTipService.ToolTip="Stop monitoring (Shift+F5)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F5" Modifiers="Shift" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ViewModel.ValidationIssues, Mode=OneTime}"
                                  Visibility="{x:Bind ViewModel.HasValidationIssues, Mode=OneWay}"
                                  AutomationProperties.Name="Folder settings problems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="worker:ValidationIssue">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Severity, Mode=OneTime}" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Bind Message, Mode=OneTime}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" MinWidth="280" />
                        </Grid.ColumnDefinitions>

                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Retry failed" Command="{x:Bind ViewModel.RetryFailedCommand}"
                                        AutomationProperties.Name="Retry all failed jobs" TabIndex="11"
                                        ToolTipService.ToolTip="Retry every failed job">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="R" Modifiers="Control,Shift" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button Content="Clear history" Command="{x:Bind ViewModel.ClearHistoryCommand}"
                                        AutomationProperties.Name="Clear finished jobs from the history" TabIndex="12"
                                        ToolTipService.ToolTip="Remove finished jobs from the list and the saved history" />
                            </StackPanel>

                            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <ListView ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneTime}" SelectionMode="Single"
                                          SelectedItem="{x:Bind ViewModel.SelectedJob, Mode=TwoWay}"
                                          AutomationProperties.Name="Conversion jobs" TabIndex="13">
                                    <ListView.Header>
                                        <Grid Padding="12,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="File" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Status" />
                                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Output / error" />
                                        </Grid>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:JobItemViewModel">
                                            <Grid Padding="0,10" ColumnSpacing="12"
                                                  AutomationProperties.Name="{x:Bind FileName, Mode=OneTime}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock TextTrimming="CharacterEllipsis" Text="{x:Bind FileName, Mode=OneTime}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind StateText, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis"
                                                           Text="{x:Bind DisplayMessage, Mode=OneWay}"
                                                           ToolTipService.ToolTip="{x:Bind DisplayMessage, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>

                        <!-- Detail pane for the selected job -->
                        <Border Grid.Column="1" Padding="16" CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                AutomationProperties.Name="Job details">
                            <Grid>
                                <TextBlock Visibility="{x:Bind ViewModel.HasNoSelectedJob, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           Text="Select a job to see its details, error and output location." />
                                <ScrollViewer Visibility="{x:Bind ViewModel.HasSelectedJob, Mode=OneWay}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                                                   Text="{x:Bind ViewModel.SelectedJob.FileName, Mode=OneWay, FallbackValue=''}"
                                                   AutomationProperties.HeadingLevel="Level2" />
                                        <StackPanel>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Status" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedJob.StateText, Mode=OneWay, FallbackValue=''}" />
                                        </StackPanel>
                                        <StackPanel Visibility="{x:Bind ViewModel.SelectedJob.HasError, Mode=OneWay, FallbackValue=Collapsed}">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Error" />
                                            <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Text="{x:Bind ViewModel.SelectedJob.Error, Mode=OneWay, FallbackValue=''}"
                                                       AutomationProperties.Name="Error message" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Source file" />
                                            <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Text="{x:Bind ViewModel.SelectedJob.SourcePath, Mode=OneWay, FallbackValue=''}"
                                                       AutomationProperties.Name="Source file path" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Output file" />
                                            <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Text="{x:Bind ViewModel.SelectedJob.OutputPath, Mode=OneWay, FallbackValue=''}"
                                                       AutomationProperties.Name="Output file path" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Attempts" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedJob.Attempts, Mode=OneWay, FallbackValue=''}" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <Button Content="Open source" Command="{x:Bind ViewModel.OpenSourceCommand}"
                                                    AutomationProperties.Name="Open source file" TabIndex="14" />
                                            <Button Content="Open output" Command="{x:Bind ViewModel.OpenOutputCommand}"
                                                    AutomationProperties.Name="Open output Markdown file" TabIndex="15" />
                                            <Button Content="Show output in folder" Command="{x:Bind ViewModel.ShowOutputInFolderCommand}"
                                                    AutomationProperties.Name="Show output file in File Explorer" TabIndex="16" />
                                            <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}"
                                                    AutomationProperties.Name="Retry this job" TabIndex="17">
                                                <Button.KeyboardAccelerators>
                                                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                                                </Button.KeyboardAccelerators>
                                            </Button>
                                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelJobCommand}"
                                                    AutomationProperties.Name="Cancel this job" TabIndex="18" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Grid>

            <!-- ===== Settings ===== -->
            <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Spacing="20" Padding="0,8,16,24" MaxWidth="760" HorizontalAlignment="Left">

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Monitoring" AutomationProperties.HeadingLevel="Level2" />
                            <NumberBox Header="Wait after a file changes (milliseconds)" Minimum="0" Maximum="60000" SpinButtonPlacementMode="Inline"
                                       Value="{x:Bind ViewModel.DebounceMilliseconds, Mode=TwoWay}" AutomationProperties.Name="Debounce delay in milliseconds" />
                            <NumberBox Header="Rescan the folder every (seconds)" Minimum="1" Maximum="86400" SpinButtonPlacementMode="Inline"
                                       Value="{x:Bind ViewModel.ReconciliationSeconds, Mode=TwoWay}" AutomationProperties.Name="Reconciliation interval in seconds" />
                            <NumberBox Header="Maximum queued files" Minimum="1" Maximum="100000" SpinButtonPlacementMode="Inline"
                                       Value="{x:Bind ViewModel.QueueCapacity, Mode=TwoWay}" AutomationProperties.Name="Maximum queue size" />
                            <ComboBox Header="When the queue is full" SelectedIndex="{x:Bind ViewModel.QueueFullIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Queue full behaviour">
                                <ComboBoxItem Content="Wait for room" />
                                <ComboBoxItem Content="Skip and pick up on the next rescan" />
                            </ComboBox>
                            <NumberBox Header="Retries after a temporary file error" Minimum="0" Maximum="20" SpinButtonPlacementMode="Inline"
                                       Value="{x:Bind ViewModel.MaxRetries, Mode=TwoWay}" AutomationProperties.Name="Number of retries" />
                            <CheckBox Content="Delete the Markdown when its source file is deleted"
                                      IsChecked="{x:Bind ViewModel.DeleteOutputWhenSourceDeleted, Mode=TwoWay}"
                                      AutomationProperties.Name="Delete output when source is deleted" />
                            <CheckBox Content="Recognise text in images (Windows OCR, slower)"
                                      IsChecked="{x:Bind ViewModel.EnableOcr, Mode=TwoWay}"
                                      AutomationProperties.Name="Enable local OCR" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Notifications and appearance" AutomationProperties.HeadingLevel="Level2" />
                            <ComboBox Header="Job notifications" SelectedIndex="{x:Bind ViewModel.JobNotificationIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Job notification mode">
                                <ComboBoxItem Content="Never" />
                                <ComboBoxItem Content="Only failures" />
                                <ComboBoxItem Content="Every conversion" />
                            </ComboBox>
                            <CheckBox Content="Notify when monitoring starts, stops or has a problem"
                                      IsChecked="{x:Bind ViewModel.NotifyApplicationEvents, Mode=TwoWay}"
                                      AutomationProperties.Name="Application notifications" />
                            <ComboBox Header="Theme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Colour theme">
                                <ComboBoxItem Content="Use Windows setting" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Startup" AutomationProperties.HeadingLevel="Level2" />
                            <ToggleSwitch Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                          AutomationProperties.Name="Start with Windows" />
                            <TextBlock Text="{x:Bind ViewModel.StartupMessage, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <CheckBox Content="Start monitoring when the app opens"
                                      IsChecked="{x:Bind ViewModel.StartMonitoringOnLaunch, Mode=TwoWay}"
                                      AutomationProperties.Name="Start monitoring on launch" />
                            <CheckBox Content="Keep running in the notification area when the window is closed"
                                      IsChecked="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                      AutomationProperties.Name="Keep running in the system tray" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Image descriptions (optional)" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Works with any OpenAI-compatible endpoint, including local servers such as Ollama. Images are sent to this endpoint." />
                            <TextBox Header="Endpoint (for example http://localhost:11434/v1)" Text="{x:Bind ViewModel.ImageEndpoint, Mode=TwoWay}"
                                     AutomationProperties.Name="Image description endpoint" />
                            <TextBox Header="Model" Text="{x:Bind ViewModel.ImageModel, Mode=TwoWay}" AutomationProperties.Name="Image description model" />
                            <PasswordBox Header="API key (optional)" Password="{x:Bind ViewModel.ImageKey, Mode=TwoWay}" AutomationProperties.Name="Image description API key" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Speech transcription (optional)" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Works with any OpenAI-compatible audio transcription endpoint. Audio files are sent to this endpoint." />
                            <TextBox Header="Endpoint" Text="{x:Bind ViewModel.TranscriptionEndpoint, Mode=TwoWay}" AutomationProperties.Name="Transcription endpoint" />
                            <TextBox Header="Model" Text="{x:Bind ViewModel.TranscriptionModel, Mode=TwoWay}" AutomationProperties.Name="Transcription model" />
                            <PasswordBox Header="API key (optional)" Password="{x:Bind ViewModel.TranscriptionKey, Mode=TwoWay}" AutomationProperties.Name="Transcription API key" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Azure AI Document Intelligence (optional)" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="When configured, PDFs, Office files and images are sent to your Azure resource instead of being converted locally." />
                            <TextBox Header="Endpoint" Text="{x:Bind ViewModel.DocumentIntelligenceEndpoint, Mode=TwoWay}" AutomationProperties.Name="Document Intelligence endpoint" />
                            <PasswordBox Header="API key" Password="{x:Bind ViewModel.DocumentIntelligenceKey, Mode=TwoWay}" AutomationProperties.Name="Document Intelligence API key" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Azure AI Content Understanding (optional)" AutomationProperties.HeadingLevel="Level2" />
                            <TextBox Header="Endpoint" Text="{x:Bind ViewModel.ContentUnderstandingEndpoint, Mode=TwoWay}" AutomationProperties.Name="Content Understanding endpoint" />
                            <PasswordBox Header="API key" Password="{x:Bind ViewModel.ContentUnderstandingKey, Mode=TwoWay}" AutomationProperties.Name="Content Understanding API key" />
                            <TextBox Header="Analyzer (leave empty for prebuilt-documentAnalyzer)" Text="{x:Bind ViewModel.ContentUnderstandingAnalyzer, Mode=TwoWay}"
                                     AutomationProperties.Name="Content Understanding analyzer" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Plugins (advanced)" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Plugins are .NET assemblies placed in the plugins folder. They run with your permissions, so each one must be trusted explicitly: by SHA-256 hash or by the thumbprint of its Authenticode signer." />
                            <ToggleSwitch Header="Load trusted plugins" IsOn="{x:Bind ViewModel.PluginsEnabled, Mode=TwoWay}" AutomationProperties.Name="Load trusted plugins" />
                            <TextBox Header="Trusted SHA-256 hashes (one per line)" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"
                                     Text="{x:Bind ViewModel.TrustedPluginHashes, Mode=TwoWay}" AutomationProperties.Name="Trusted plugin hashes" />
                            <TextBox Header="Trusted signer thumbprints (one per line)" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"
                                     Text="{x:Bind ViewModel.TrustedPluginSigners, Mode=TwoWay}" AutomationProperties.Name="Trusted signer thumbprints" />
                            <Button Content="Open plugins folder" Click="OpenPluginsFolder_Click" AutomationProperties.Name="Open the plugins folder" />
                        </StackPanel>

                        <Button Content="Save settings" Command="{x:Bind ViewModel.ApplySettingsCommand}" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="Save settings" ToolTipService.ToolTip="Save settings (Ctrl+S)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Converters ===== -->
            <Grid x:Name="ConvertersPanel" Visibility="Collapsed">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Turn converters on or off. When several converters accept a file, the one with the lowest priority number is used. Changes apply the next time monitoring starts." />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Converters, Mode=OneTime}" SelectionMode="None"
                              AutomationProperties.Name="Converters">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:ConverterItemViewModel">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent=""
                                                  AutomationProperties.Name="{x:Bind Name, Mode=OneTime}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneTime}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Bind Description, Mode=OneTime}" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Extensions, Mode=OneTime}" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Details, Mode=OneTime}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ViewModel.PluginMessages, Mode=OneTime}"
                                  AutomationProperties.Name="Plugin load results" />
                </Grid>
            </Grid>

            <!-- ===== About and diagnostics ===== -->
            <Grid x:Name="AboutPanel" Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,8,16,24" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2">
                            <Run Text="MarkItDownSharp " /><Run Text="{x:Bind ViewModel.ApplicationVersion, Mode=OneTime}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Diagnostics contain versions only: no file names, paths or document content." />
                        <Border Padding="12" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}" AutomationProperties.Name="Diagnostics" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" AutomationProperties.Name="Copy diagnostics to the clipboard" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Crash reports" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="If the app crashes it writes a report to this computer. Reports contain the error type and call stack only and are never sent anywhere automatically. You can attach one to a bug report." />
                        <TextBlock>
                            <Run Text="Saved reports: " /><Run Text="{x:Bind ViewModel.CrashReportCount, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="Open crash reports folder" Click="OpenCrashFolder_Click" AutomationProperties.Name="Open the crash reports folder" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

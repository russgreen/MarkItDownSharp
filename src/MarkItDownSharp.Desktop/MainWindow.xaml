<Window
    x:Class="MarkItDownSharp.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="using:MarkItDownSharp.Desktop"
    Title="MarkItDownSharp">
    <Grid Padding="28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="MarkItDownSharp" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Convert files added to a folder into Markdown." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Monitor folder" />
            <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Text="{x:Bind ViewModel.SourceDirectory, Mode=OneWay}" />
            <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseSource_Click" />
            <Button Grid.Row="0" Grid.Column="3" Content="Start" Command="{x:Bind ViewModel.StartCommand}" />

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Output folder" />
            <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{x:Bind ViewModel.OutputDirectory, Mode=OneWay}" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click" />
            <Button Grid.Row="1" Grid.Column="3" Content="Stop" Command="{x:Bind ViewModel.StopCommand}" />

            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="18">
                <CheckBox Content="Include subfolders" IsChecked="{x:Bind ViewModel.IncludeSubdirectories, Mode=TwoWay}" />
                <CheckBox Content="Process existing files" IsChecked="{x:Bind ViewModel.ProcessExistingFiles, Mode=TwoWay}" />
                <ComboBox Header="Existing output" SelectedIndex="{x:Bind ViewModel.CollisionIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Overwrite" />
                    <ComboBoxItem Content="Skip" />
                    <ComboBoxItem Content="Create version" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <ListView ItemsSource="{x:Bind ViewModel.Jobs}" SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="12,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="File" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Status" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Output / error" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="desktop:JobItemViewModel">
                        <Grid Padding="0,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock TextTrimming="CharacterEllipsis" Text="{x:Bind FileName}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind State, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis"
                                       Text="{x:Bind DisplayMessage, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind DisplayMessage, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
    </Grid>
</Window>
